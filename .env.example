# Token del bot de Telegram (BotFather)
TELEGRAM_TOKEN=123456:dummy-token

# Postgres async (asyncpg). En docker compose el host es "db".
DATABASE_URL=postgresql+asyncpg://asesor:asesor@localhost:5432/asesor

# LLM (OpenAI por default; cambiar base_url/model para otro provider)
LLM_API_KEY=sk-dummy
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
AUDIO_MODEL=whisper-1

# Whitelist: telegram_id:nombre:telefono (telefono opcional), separados por coma
ALLOWED_USERS=111111111:Braian:+5493511234567

# Zona horaria de negocio
TZ=America/Argentina/Buenos_Aires

LOG_LEVEL=INFO
